#!/bin/sh
# THE backup runner — one script, strictly ordered, so nothing can interleave:
#
#   per partition (one Active node of BACKUP_ROLE, from the operator's map):
#     1. fresh local checkpoint  (flared `backup` op; hard-links, near-instant;
#        local generations are a byproduct — flared prunes to rocksdb-backup-keep)
#     2. pull it out of the pod  (kubectl cp)
#     3. RESTORE-CONSISTENT 3-phase upload to <BUCKET>/<CLUSTER>/latest/p<N>/
#     4. verify CURRENT -> MANIFEST in the bucket
#   then, once per UTC day (first run that finds no snapshots/<today>/):
#     5. server-side copy latest/ -> snapshots/<YYYYMMDD>/ + verify
#     6. prune generations older than KEEP_DAYS
#
# Steps 5-6 run in the SAME process after 3-4, so the daily generation can
# never copy a latest/ that a concurrent delta is mutating (the old split
# delta/daily CronJobs could race exactly that way). Schedule ONE CronJob,
# hourly, with concurrencyPolicy: Forbid (self-overlap) and
# activeDeadlineSeconds < the cadence (a hung run dies before its next slot).
#
# env: CLUSTER NAMESPACE FLARE_PORT BACKUP_ROLE(master|slave) OPERATOR_SVC
#      OPERATOR_PORT BUCKET(s3://bucket/prefix, no trailing slash)
#      S3_ENDPOINT(empty for AWS) DATA_DIR(default /data/flare)
#      KEEP_DAYS(default 14; 0 disables the daily generation)
#      SNAPSHOT_AFTER_HOUR_UTC(default 0): the daily generation is created by
#        the first SUCCESSFUL run at-or-after this UTC hour (e.g. 18 = first
#        run after 18:00 UTC / 03:00 JST). Generations are named by UTC date.
# auth: keyless via AWS_ROLE_ARN + AWS_WEB_IDENTITY_TOKEN_FILE (OIDC), or any
#       credentials aws-cli understands (env/secret).
set -e

EP=""; [ -n "$S3_ENDPOINT" ] && EP="--endpoint-url $S3_ENDPOINT"
DATA_DIR="${DATA_DIR:-/data/flare}"
KEEP_DAYS="${KEEP_DAYS:-14}"
SNAPSHOT_AFTER_HOUR_UTC="${SNAPSHOT_AFTER_HOUR_UTC:-0}"

# ---- delta: one target pod per partition of the chosen role ----
RC=0; [ "$BACKUP_ROLE" = "slave" ] && RC=1
# NODE <name> <port> <role> <state> <partition> ...; role master=0 slave=1,
# state Active=0. One Active node per partition ($6). Emits "<pod>:<partition>".
TARGETS=$(printf 'node sync\r\n' | nc -w 5 "$OPERATOR_SVC" "$OPERATOR_PORT" \
  | awk -v rc="$RC" '/^NODE/ && $4==rc && $5==0 { part=$6; if (!(part in s)) { s[part]=1; split($2,a,"."); print a[1]":"part } }')
[ -z "$TARGETS" ] && { echo "no backup targets for role=$BACKUP_ROLE via node sync"; exit 1; }

FAIL=0
for T in $TARGETS; do
  POD="${T%%:*}"; PART="${T##*:}"
  HOST="${POD}.${CLUSTER}-nodes.${NAMESPACE}.svc.cluster.local"
  STAMP=$(date -u +%Y%m%d-%H%M%S)
  DST="${BUCKET}/${CLUSTER}/latest/p${PART}"

  # 1) fresh consistent checkpoint
  REPLY=$(printf 'backup %s\r\n' "$STAMP" | nc -w 30 "$HOST" "$FLARE_PORT" || true)
  case "$REPLY" in *ERROR*|"") echo "checkpoint FAILED on ${POD}"; FAIL=1; continue ;; esac

  # 2) copy the checkpoint out of the pod (intra-cluster)
  SRC="/tmp/${POD}"
  rm -rf "$SRC"; mkdir -p "$SRC"
  kubectl cp -n "$NAMESPACE" "${POD}:${DATA_DIR}/backups/${STAMP}" "$SRC"

  # 3) 3-phase upload. `aws s3 sync --size-only` compares FILE SIZE only
  #    (mtimes are useless after kubectl cp) — right for immutable SSTs,
  #    WRONG for the fixed-name CURRENT pointer (MANIFEST-000123 ->
  #    MANIFEST-000124 at the same byte length would be skipped, then
  #    --delete removes the MANIFEST it names -> unrestorable mirror).
  #    A: new immutable objects, NO delete (old CURRENT stays valid).
  aws s3 sync "$SRC" "${DST}/" --size-only $EP || FAIL=1
  #    B: force-refresh the fixed-name pointer files.
  for f in CURRENT IDENTITY; do
    [ -f "$SRC/$f" ] && aws s3 cp "$SRC/$f" "${DST}/$f" $EP
  done
  #    C: prune objects no longer in the checkpoint.
  aws s3 sync "$SRC" "${DST}/" --size-only --delete $EP || FAIL=1
  rm -rf "$SRC"

  # 4) verify the mirror is restorable
  CUR=$(aws s3 cp "${DST}/CURRENT" - $EP 2>/dev/null | tr -d '\r\n ')
  if [ -z "$CUR" ] || ! aws s3 ls "${DST}/${CUR}" $EP >/dev/null 2>&1; then
    echo "VERIFY FAILED on ${POD}: CURRENT -> '${CUR}' not present in ${DST}/"
    FAIL=1
  else
    echo "verified ${POD}: CURRENT -> ${CUR}"
  fi
done

# A failed delta must not become the daily generation.
[ "$FAIL" -ne 0 ] && exit "$FAIL"
[ "$KEEP_DAYS" -eq 0 ] && exit 0

# ---- daily generation: the first successful run at-or-after
# SNAPSHOT_AFTER_HOUR_UTC creates it (named by UTC date) ----
DATE=$(date -u +%Y%m%d)
HOUR=$(date -u +%H); HOUR=${HOUR#0}   # strip the zero-pad ("08" -> "8")
if [ "$HOUR" -lt "$SNAPSHOT_AFTER_HOUR_UTC" ]; then
  exit 0   # before today's snapshot window
fi
if aws s3 ls $EP "${BUCKET}/${CLUSTER}/snapshots/${DATE}/" >/dev/null 2>&1; then
  exit 0   # today's generation already exists
fi
echo "creating daily generation snapshots/${DATE}/"
# --copy-props none: a plain server-side copy tries to carry object tags and
# needs s3:GetObjectTagging, which the backup role need not have.
aws s3 cp --recursive --copy-props none $EP \
  "${BUCKET}/${CLUSTER}/latest/" \
  "${BUCKET}/${CLUSTER}/snapshots/${DATE}/"

# verify each snapshotted partition mirror is restorable
for p in $(aws s3 ls $EP "${BUCKET}/${CLUSTER}/snapshots/${DATE}/" | awk '{print $2}' | tr -d '/'); do
  D="${BUCKET}/${CLUSTER}/snapshots/${DATE}/${p}"
  CUR=$(aws s3 cp "${D}/CURRENT" - $EP 2>/dev/null | tr -d '\r\n ')
  if [ -z "$CUR" ] || ! aws s3 ls "${D}/${CUR}" $EP >/dev/null 2>&1; then
    echo "SNAPSHOT VERIFY FAILED for ${p}: CURRENT -> '${CUR}' missing"; exit 1
  fi
  echo "verified snapshot ${p}: CURRENT -> ${CUR}"
done

# prune generations older than KEEP_DAYS (compare YYYYMMDD)
CUTOFF=$(date -u -d "-${KEEP_DAYS} days" +%Y%m%d 2>/dev/null || date -u -v-${KEEP_DAYS}d +%Y%m%d)
for d in $(aws s3 ls $EP "${BUCKET}/${CLUSTER}/snapshots/" | awk '{print $2}' | tr -d '/'); do
  case "$d" in ''|*[!0-9]*) continue ;; esac
  if [ "$d" -lt "$CUTOFF" ]; then
    echo "pruning old snapshot ${d}"
    aws s3 rm --recursive $EP "${BUCKET}/${CLUSTER}/snapshots/${d}/"
  fi
done
