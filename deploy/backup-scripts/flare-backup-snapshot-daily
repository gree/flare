#!/bin/sh
# Tier-2b: once-a-day FULL retained snapshot, entirely server-side (no cluster
# egress): copies <BUCKET>/<CLUSTER>/latest/ to a dated generation
# <BUCKET>/<CLUSTER>/snapshots/<YYYYMMDD>/, verifies each partition mirror is
# restorable, and prunes generations older than KEEP_DAYS.
#
# env: CLUSTER BUCKET(s3://bucket/prefix) S3_ENDPOINT(empty for AWS) KEEP_DAYS(default 14)
set -e

EP=""; [ -n "$S3_ENDPOINT" ] && EP="--endpoint-url $S3_ENDPOINT"
KEEP_DAYS="${KEEP_DAYS:-14}"
DATE=$(date -u +%Y%m%d)

# --copy-props none: a plain server-side copy tries to carry object tags/props
# over and needs s3:GetObjectTagging, which the backup role does not (and need
# not) have — checkpoint files carry no tags.
aws s3 cp --recursive --copy-props none $EP \
  "${BUCKET}/${CLUSTER}/latest/" \
  "${BUCKET}/${CLUSTER}/snapshots/${DATE}/"

# Verify each snapshotted partition mirror is restorable (CURRENT names a
# MANIFEST present under the dated snapshot).
for p in $(aws s3 ls $EP "${BUCKET}/${CLUSTER}/snapshots/${DATE}/" | awk '{print $2}' | tr -d '/'); do
  D="${BUCKET}/${CLUSTER}/snapshots/${DATE}/${p}"
  CUR=$(aws s3 cp "${D}/CURRENT" - $EP 2>/dev/null | tr -d '\r\n ')
  if [ -z "$CUR" ] || ! aws s3 ls "${D}/${CUR}" $EP >/dev/null 2>&1; then
    echo "SNAPSHOT VERIFY FAILED for ${p}: CURRENT -> '${CUR}' missing"; exit 1
  fi
  echo "verified snapshot ${p}: CURRENT -> ${CUR}"
done

# Prune snapshot generations older than KEEP_DAYS (compare YYYYMMDD).
CUTOFF=$(date -u -d "-${KEEP_DAYS} days" +%Y%m%d 2>/dev/null || date -u -v-${KEEP_DAYS}d +%Y%m%d)
for d in $(aws s3 ls $EP "${BUCKET}/${CLUSTER}/snapshots/" | awk '{print $2}' | tr -d '/'); do
  case "$d" in ''|*[!0-9]*) continue ;; esac
  if [ "$d" -lt "$CUTOFF" ]; then
    echo "pruning old snapshot ${d}"
    aws s3 rm --recursive $EP "${BUCKET}/${CLUSTER}/snapshots/${d}/"
  fi
done
